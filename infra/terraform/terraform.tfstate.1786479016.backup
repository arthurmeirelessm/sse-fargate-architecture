            "id": "3872152953",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::275573050667:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/A160B3017C972A66D49563BB381F062A\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/A160B3017C972A66D49563BB381F062A:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.us-east-1.amazonaws.com/id/A160B3017C972A66D49563BB381F062A:sub\": \"system:serviceaccount:kube-system:aws-load-balancer-controller\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::275573050667:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/A160B3017C972A66D49563BB381F062A\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.us-east-1.amazonaws.com/id/A160B3017C972A66D49563BB381F062A:aud\":\"sts.amazonaws.com\",\"oidc.eks.us-east-1.amazonaws.com/id/A160B3017C972A66D49563BB381F062A:sub\":\"system:serviceaccount:kube-system:aws-load-balancer-controller\"}}}]}",
