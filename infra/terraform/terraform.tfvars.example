# Copie para terraform.tfvars e preencha com os seus valores.
# NUNCA commite o terraform.tfvars real.

aws_region     = "us-east-1"
project_name   = "sse-poc"

# Default recomendado para testar o fluxo na AWS sem domínio:
# cria ALB HTTP público e você acessa pelo DNS automático do ALB.
enable_custom_domain = false

# Preencha os campos abaixo SOMENTE se enable_custom_domain=true.
# Nesse modo o Terraform cria Route 53 + ACM + HTTPS.
# hosted_zone_id = "Z0000000EXEMPLO"
# domain_name    = "seudominio.com"

# Resultado: poc.seudominio.com (não use o domínio raiz)
subdomain      = "poc"

image_tag          = "latest"
log_retention_days = 7
